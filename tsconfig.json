{
  "compilerOptions": {
    "module": "esnext",
    "lib": [
      "es2018"
    ],
    "target": "es2018",
    "moduleResolution": "node10",
    "rootDir": "./src/",
    "outDir": "./dist/",
    "baseUrl": "./src/",
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "screeps",
      "lodash",
      "node"
    ]
  },
  "exclude": [
    "./node_modules/"
  ],
  "include": [
    "./src/**/*"
  ]
}
