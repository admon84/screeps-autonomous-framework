{
  "name": "screeps-autonomous-framework",
  "version": "1.0.0",
  "description": "Screeps World Autonomous Bot Framework Base",
  "author": "admon84",
  "homepage": "https://github.com/admon84/screeps-autonomous-framework/",
  "repository": "github:admon84/screeps-autonomous-framework",
  "bugs": "https://github.com/admon84/screeps-autonomous-framework/issues",
  "license": "Unlicense",
  "main": "src/main.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "lint-fix": "npm run lint -- --fix",
    "format": "prettier src/**/*.ts --write",
    "build": "rollup -c",
    "push-main": "rollup -c --environment DEST:main",
    "push-season": "rollup -c --environment DEST:season",
    "push-pserver": "rollup -c --environment DEST:pserver",
    "push-sim": "rollup -c --environment DEST:sim",
    "watch-sim": "rollup -cw --environment DEST:sim"
  },
  "devDependencies": {
    "@admon-dev/rollup-plugin-screeps": "^0.2.4",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/lodash": "3.10.9",
    "@types/node": "25.6.0",
    "@types/screeps": "^3.3.8",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@typescript-eslint/typescript-estree": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rollup": "^4.60.2",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "source-map": "0.6.1"
  },
  "overrides": {
    "axios": "^1.13.6"
  }
}
